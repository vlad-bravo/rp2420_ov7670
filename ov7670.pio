.program ov7670_capture
;.side_set 0
.define public HREF_PIN 28 ; Номер пина HREF (настраивается в C++)
.define public PCLK_PIN 27 ; Номер пина HREF (настраивается в C++)

; PIO захватывает 8 бит данных по нарастающему фронту PCLK.
; В формате YUYV байты идут парами: Y0, U0, Y1, V0.
; Мы считываем первый байт (Y), игнорируем второй (U/V) и упаковываем 4 значения Y в одно 32-битное слово.
.wrap_target
wait_for_line:
    wait 1 gpio HREF_PIN      ; Ждем начала строки (HREF = 1)

p_loop:
    wait 1 pin PCLK_PIN       ; Ждем тактовый импульс (PCLK = 1)
    in pins, 6                ; Считываем Y-байт
    wait 0 pin PCLK_PIN       ; Ждем спад PCLK
    wait 1 pin PCLK_PIN       ; Ждем следующий такт (байт U/V)
    wait 0 pin PCLK_PIN       ; Игнорируем байт цвета
    
    ; Повторяем для Y1, U1, Y2, V2, Y3, U3 (всего 4 пикселя за цикл)
    wait 1 pin PCLK_PIN
    in pins, 6
    wait 0 pin PCLK_PIN
    wait 1 pin PCLK_PIN
    wait 0 pin PCLK_PIN

    wait 1 pin PCLK_PIN
    in pins, 6
    wait 0 pin PCLK_PIN
    wait 1 pin PCLK_PIN
    wait 0 pin PCLK_PIN

    wait 1 pin PCLK_PIN
    in pins, 6
    wait 0 pin PCLK_PIN
    wait 1 pin PCLK_PIN
    wait 0 pin PCLK_PIN

    ;jmp HREF_PIN p_loop       ; Если HREF еще 1, продолжаем строку. Если 0 - строка закончилась
    jmp wait_for_line         ; Ждем следующую строку
.wrap
